digraph AITurnFlow {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.55",
    nodesep="0.55",
    ranksep="0.82",
    splines=polyline,
    outputorder=edgesfirst,
    compound=true,
    newrank=true,
    forcelabels=true,
    fontname="Avenir",
    label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="34"><B>Guarded AI Turn</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="14" COLOR="#5b6b80">One lazy typed Worker owns every engine; only a current, legal result may change the game.</FONT></TD></TR></TABLE>>,
    labelloc=t,
    labeljust=c
  ];

  node [
    shape=box,
    style="rounded,filled",
    margin="0.21,0.13",
    width=2.9,
    height=0.72,
    fontname="Avenir",
    fontsize=18,
    penwidth=2.4,
    fontcolor="#14213d",
    color="#2264c7",
    fillcolor="#eaf3ff:#ffffff",
    gradientangle=270
  ];

  edge [
    color="#263a59",
    fontname="Avenir",
    fontsize=13,
    fontcolor="#3d4a5c",
    penwidth=2.2,
    arrowsize=0.78
  ];

  subgraph cluster_orchestration {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#1f5fbf"><B>GAME ORCHESTRATION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#496f9f">The scheduler starts work; the store owns the only state-changing exit.</FONT></TD></TR></TABLE>>,
      labelloc=t,
      labeljust=l,
      color="#b9d8ff",
      fillcolor="#f5faff",
      style="rounded,filled",
      penwidth=1.8,
      margin=20
    ];

    START [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>AI-controlled turn</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">useGameTurnScheduler requests a move</FONT></TD></TR></TABLE>>];
    SNAPSHOT [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Snapshot turn identity</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">game ID, player, roll, history length</FONT></TD></TR></TABLE>>];
    POSITION [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Project AIPosition</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">14 squares, player, roll — no history or board</FONT></TD></TR></TABLE>>];

    START -> SNAPSHOT -> POSITION;
  }

  subgraph cluster_boundary {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#8a5f00"><B>LAZY, BOUNDED ASYNC BOUNDARY</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#836b27">One protocol correlates requests, enforces a timeout, and restarts a failed Worker.</FONT></TD></TR></TABLE>>,
      labelloc=t,
      labeljust=l,
      color="#f2cf78",
      fillcolor="#fffaf0",
      style="rounded,filled",
      penwidth=1.8,
      margin=20
    ];

    ADAPTER [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Thin engine adapter</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">Classic, heuristic, or ML result schema</FONT></TD></TR></TABLE>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    CLIENT [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>AIWorkerClient</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">lazy owner, request ID, 30 s timeout</FONT></TD></TR></TABLE>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    WORKER [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Single Web Worker</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">validates discriminated request</FONT></TD></TR></TABLE>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00", penwidth=3.2];

    ADAPTER -> CLIENT [label="engine + AIPosition"];
    CLIENT -> WORKER [label="typed request"];
  }

  subgraph cluster_core {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b46a3"><B>WORKER-LOCAL RUST / WASM</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#76569b">WASM and ML data are loaded once, on demand, away from the UI thread.</FONT></TD></TR></TABLE>>,
      labelloc=t,
      labeljust=l,
      color="#d6c3f5",
      fillcolor="#faf7ff",
      style="rounded,filled",
      penwidth=1.8,
      margin=20
    ];

    ENGINE [shape=diamond, label="Engine?", width=2.0, height=1.02, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    SEARCH [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Classic / heuristic</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">bounded expectiminimax cache</FONT></TD></TR></TABLE>>, fillcolor="#f2eaff:#ffffff", color="#805ad5"];
    MODEL [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Load ML weights once</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">fetch, stream gunzip, parse, validate</FONT></TD></TR></TABLE>>, fillcolor="#f2eaff:#ffffff", color="#805ad5"];
    NETWORK [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>ML inference</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">value + policy networks</FONT></TD></TR></TABLE>>, fillcolor="#f2eaff:#ffffff", color="#805ad5"];
    PARSE [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Validate and normalize</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">engine result schema</FONT></TD></TR></TABLE>>, fillcolor="#f2eaff:#ffffff", color="#805ad5"];

    ENGINE -> SEARCH [label="Classic / heuristic"];
    ENGINE -> MODEL [label="ML"];
    MODEL -> NETWORK;
    SEARCH -> PARSE;
    NETWORK -> PARSE;
    { rank=same; SEARCH; MODEL; }
  }

  subgraph cluster_guards {
    graph [
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#1e6b43"><B>RESULT GUARDS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#4e7a61">Fallback is an orchestration decision; adapters never mutate game state.</FONT></TD></TR></TABLE>>,
      labelloc=t,
      labeljust=l,
      color="#b8e5c8",
      fillcolor="#f4fbf6",
      style="rounded,filled",
      penwidth=1.8,
      margin=20
    ];

    CURRENT [shape=diamond, label="Same game\nand turn?", width=2.25, height=1.18, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    LEGAL [shape=diamond, label="Move is\nlegal?", width=2.05, height=1.05, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    DISCARD [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Discard stale result</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">no game-state update</FONT></TD></TR></TABLE>>, fillcolor="#fde2e1:#fff5f5", color="#c53030"];
    FAILURE [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Request cannot produce a move</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">timeout, worker failure, invalid payload</FONT></TD></TR></TABLE>>, fillcolor="#fde2e1:#fff5f5", color="#c53030"];
    FALLBACK [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Select first legal fallback</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">one deterministic centralized policy</FONT></TD></TR></TABLE>>, fillcolor="#fff4d1:#fffaf0", color="#d39a00"];
    APPLY [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><B>Apply through makeMove</B></TD></TR><TR><TD CELLPADDING="4"><FONT POINT-SIZE="15">pure transition + Zustand single writer</FONT></TD></TR></TABLE>>, fillcolor="#d8f5de:#effcf2", color="#15803d", penwidth=3.2];

    CURRENT -> DISCARD [label="No", color="#c53030", fontcolor="#c53030"];
    CURRENT -> LEGAL [label="Yes"];
    LEGAL -> APPLY [label="Yes"];
    LEGAL -> FALLBACK [label="No", style=dashed, color="#d39a00", fontcolor="#8a5f00"];
    FAILURE -> FALLBACK [style=dashed, color="#c53030"];
    FALLBACK -> APPLY [style=dashed, color="#d39a00"];
  }

  POSITION -> ADAPTER [lhead=cluster_boundary];
  WORKER -> ENGINE [lhead=cluster_core];
  PARSE -> CURRENT [label="validated response", ltail=cluster_core, lhead=cluster_guards];
  CLIENT -> FAILURE [label="timeout / worker error", style=dashed, color="#c53030", fontcolor="#c53030", constraint=false];
  PARSE -> FAILURE [label="invalid result", style=dashed, color="#c53030", fontcolor="#c53030", constraint=false];
}
